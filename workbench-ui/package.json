{
  "name": "workbench-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Jarvis 工作台前端唯一源码（React + TS + Vite，双产物：插件 IIFE / 独立版）",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:plugin": "vite build --mode plugin",
    "build:standalone": "vite build --mode standalone",
    "build": "npm run typecheck && npm run build:plugin && npm run build:standalone && node scripts/distribute.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "type": "module"
}
